  29          void task_suspend(unsigned char tid)// 任务挂起
  30          {
  31   1          if (tid >= MAX_TASKS) return;
  32   1          task_state[tid] = TASK_SUSPEND;
  33   1          task_delay[tid] = 0;          // 手动挂起不使用定时恢复
  34   1      }
  35          
  36          void task_resume(unsigned char tid)   //恢复任务
  37          {
  38   1          if (tid >= MAX_TASKS) return;
  39   1          task_state[tid] = TASK_READY;
  40   1          task_delay[tid] = 0;
  41   1      }
  42          
  43          
  44          void task_delay_ms(unsigned int ms)// 切换的延时
  45          {
  46   1          if (ms == 0) return;
  47   1          task_delay[task_id] = ms;           // 设置延时计数
  48   1          task_state[task_id] = TASK_SUSPEND; // //任务状态设置为挂起
  49   1          task_switch();                      // 任务切换
  50   1      }
  51          
  52          
  53          void task_switch(void)// 任务切换
  54          {
C51 COMPILER V9.60.0.0   MAIN                                                              03/31/2026 19:04:17 PAGE 2   

  55   1          task_sp[task_id] = SP;
  56   1          do
  57   1          {
