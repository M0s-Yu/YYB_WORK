  87          
  88          void task_load(unsigned int fn, unsigned char tid)//任务加载
  89          {
  90   1          task_stack[tid][1] = (unsigned char)(fn >> 8);
  91   1          task_stack[tid][0] = (unsigned char)fn;
  92   1          task_sp[tid] = (unsigned char)&task_stack[tid][1];
  93   1      }
  94          
